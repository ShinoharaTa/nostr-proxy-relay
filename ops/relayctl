#!/usr/bin/env bash
# Blue/Green スロット操作（Issue #39）
#
#   blue  = 安定版（常用）   :8081
#   green = 開発版           :8082
#   Caddy(:8080) が現在の向き先へ流す。URL は常に 1 つ（r-test.shino3.net）。
#
# 使い方:
#   relayctl status                    現在の向き先・各スロットの版と health
#   relayctl deploy green [ref] [--with-db]
#                                      ref(既定 HEAD) をビルドして green を再起動
#   relayctl point green|blue          URL の向き先を切替（health 確認後）
#   relayctl promote                   green で動いている版を blue に反映し blue へ戻す
#   relayctl rollback                  直前の向き先へ戻す
#   relayctl logs blue|green [n]       ログ表示
set -euo pipefail

REPO=${RELAYCTL_REPO:-/root/nostr-proxy-relay}
ROOT=${RELAYCTL_ROOT:-/srv/relay}
ACTIVE_CONF=${RELAYCTL_ACTIVE_CONF:-/etc/caddy/active-slot.conf}
STATE=$ROOT/state
CADDY_ADMIN=${RELAYCTL_CADDY_ADMIN:-http://localhost:2019}

declare -A PORT=([blue]=8081 [green]=8082)

die() { echo "ERROR: $*" >&2; exit 1; }
slot_valid() { [[ -n "${PORT[$1]:-}" ]] || die "unknown slot: $1 (blue|green)"; }

current_slot() {
  [[ -f $STATE/active ]] && cat "$STATE/active" || echo blue
}
other_slot() { [[ $(current_slot) == blue ]] && echo green || echo blue; }

# スロットが応答するか（切替前の必須チェック）
health() {
  local slot=$1
  curl -sf -o /dev/null --max-time 5 "http://127.0.0.1:${PORT[$slot]}/healthz" && echo ok || echo down
}

slot_version() {
  local slot=$1
  [[ -f $ROOT/$slot/VERSION ]] && cat "$ROOT/$slot/VERSION" || echo "-"
}

write_active_conf() {
  local slot=$1
  cat > "$ACTIVE_CONF" <<EOF
# generated by relayctl at $(date -Is) — active slot: $slot
reverse_proxy 127.0.0.1:${PORT[$slot]}
EOF
}

reload_caddy() {
  # 設定の妥当性を確認してから無停止リロード
  caddy validate --config /etc/caddy/Caddyfile >/dev/null 2>&1 \
    || die "Caddyfile validation failed; 切替を中止しました"
  systemctl reload caddy
}

cmd_status() {
  local cur; cur=$(current_slot)
  echo "URL の向き先: $cur"
  printf "%-7s %-6s %-8s %-10s %s\n" SLOT PORT HEALTH ACTIVE VERSION
  for s in blue green; do
    printf "%-7s %-6s %-8s %-10s %s\n" "$s" "${PORT[$s]}" "$(health "$s")" \
      "$([[ $s == "$cur" ]] && echo '← LIVE' || echo '')" "$(slot_version "$s")"
  done
  [[ -f $STATE/previous ]] && echo "直前の向き先: $(cat "$STATE/previous")" || true
}

cmd_deploy() {
  local slot=${1:-green}; slot_valid "$slot"
  local ref=${2:-HEAD}
  local with_db=false
  [[ "${3:-}" == "--with-db" || "${2:-}" == "--with-db" ]] && with_db=true
  [[ "${2:-}" == "--with-db" ]] && ref=HEAD

  local cur; cur=$(current_slot)
  [[ $slot == "$cur" ]] && die "本番の向き先 ($cur) には deploy できません。先に point で切り替えてください"

  echo ">> building $ref → $slot"
  git -C "$REPO" rev-parse --verify "$ref" >/dev/null || die "不正な git ref: $ref"
  local sha; sha=$(git -C "$REPO" rev-parse --short "$ref")

  # 指定 ref を隔離した worktree に展開してビルドする。
  # REPO の作業ツリーで直接ビルドすると、checkout 中のブランチが何であれ
  # その内容がビルドされてしまい「ref を指定したのに別物が入る」事故になる。
  local wt; wt=$(mktemp -d /tmp/relayctl-build.XXXXXX)
  trap 'git -C "$REPO" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"' RETURN
  git -C "$REPO" worktree add --detach --quiet "$wt" "$ref" || die "worktree の作成に失敗しました"
  # target/ は REPO と共有してビルドを再利用する
  ( cd "$wt" && CARGO_TARGET_DIR="$REPO/target" cargo build --release --offline 2>&1 | tail -2 )
  local built=$REPO/target/release/proxy-nostr-relay

  mkdir -p "$ROOT/$slot/logs"
  systemctl stop "relay-$slot" 2>/dev/null || true
  install -m755 "$built" "$ROOT/$slot/proxy-nostr-relay"
  echo "$sha ($(git -C "$REPO" log -1 --format=%s "$ref" | cut -c1-60))" > "$ROOT/$slot/VERSION"

  if $with_db; then
    local src=$ROOT/$cur/app.sqlite
    if [[ -f $src ]]; then
      echo ">> $cur の DB を $slot へ複製（バックアップ付き）"
      [[ -f $ROOT/$slot/app.sqlite ]] && cp "$ROOT/$slot/app.sqlite" "$ROOT/$slot/app.sqlite.bak.$(date +%s)"
      # WAL を畳んでから安全にコピー
      sqlite3 "$src" "VACUUM INTO '$ROOT/$slot/app.sqlite.tmp'" && mv "$ROOT/$slot/app.sqlite.tmp" "$ROOT/$slot/app.sqlite"
    fi
  fi

  systemctl start "relay-$slot"
  for _ in $(seq 1 20); do [[ $(health "$slot") == ok ]] && break; sleep 0.5; done
  [[ $(health "$slot") == ok ]] || die "$slot が起動しませんでした（journalctl -u relay-$slot で確認）"
  echo ">> $slot = $sha 起動 OK（まだ URL は $cur を向いています）"
}

cmd_point() {
  local slot=${1:?point blue|green}; slot_valid "$slot"
  local cur; cur=$(current_slot)
  [[ $slot == "$cur" ]] && { echo "既に $slot を向いています"; return 0; }
  [[ $(health "$slot") == ok ]] || die "$slot が応答しません。切替を中止しました"

  mkdir -p "$STATE"; echo "$cur" > "$STATE/previous"
  write_active_conf "$slot"; reload_caddy
  echo "$slot" > "$STATE/active"
  echo ">> URL の向き先: $cur → $slot"
}

cmd_promote() {
  # green で検証済みの版を blue に反映し、URL を blue に戻す
  [[ $(health green) == ok ]] || die "green が応答しません"
  local ver; ver=$(slot_version green); local sha=${ver%% *}
  [[ -n $sha && $sha != "-" ]] || die "green の版が特定できません。先に deploy green を実行してください"

  echo ">> green の $sha を blue へ反映します"
  systemctl stop relay-blue 2>/dev/null || true
  install -m755 "$ROOT/green/proxy-nostr-relay" "$ROOT/blue/proxy-nostr-relay"
  cp "$ROOT/green/VERSION" "$ROOT/blue/VERSION"
  systemctl start relay-blue
  for _ in $(seq 1 20); do [[ $(health blue) == ok ]] && break; sleep 0.5; done
  [[ $(health blue) == ok ]] || die "blue が起動しませんでした（rollback してください）"
  cmd_point blue
  echo ">> promote 完了: blue = $sha（green は開発用にそのまま残っています）"
}

cmd_rollback() {
  [[ -f $STATE/previous ]] || die "戻り先の記録がありません"
  cmd_point "$(cat "$STATE/previous")"
}

cmd_logs() {
  local slot=${1:?logs blue|green}; slot_valid "$slot"
  journalctl -u "relay-$slot" -n "${2:-50}" --no-pager
}

case "${1:-status}" in
  status)   cmd_status ;;
  deploy)   shift; cmd_deploy "$@" ;;
  point)    shift; cmd_point "$@" ;;
  promote)  cmd_promote ;;
  rollback) cmd_rollback ;;
  logs)     shift; cmd_logs "$@" ;;
  *)        sed -n '2,20p' "$0"; exit 1 ;;
esac
