[Unit]
Description=Nostr Proxy Relay (blue / stable slot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/relay/blue
EnvironmentFile=/srv/relay/blue/env
ExecStart=/srv/relay/blue/proxy-nostr-relay
Restart=always
RestartSec=3
# ログは journald へ（ファイルログは LOG_DIR 側で別途ローテート）
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
